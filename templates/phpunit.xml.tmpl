<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit boilerplate for a CWM Joomla extension.

    Copied into the project once by `cwm-sync-configs` and then owned by
    the project — unlike .editorconfig and .php-cs-fixer.dist.php, this
    file is never overwritten, because the testsuite list and the source
    directories are project shape, not shared policy.

    Strict mode is the point of shipping a template at all: warnings,
    notices and deprecations fail the run rather than scrolling past, and
    execution order is randomised so an order-dependent test surfaces on
    the branch that introduced it instead of months later. cwm-build-tools
    runs its own suite this way.

    Adjust <directory> entries to match the project's layout, then:
        vendor/bin/phpunit
        vendor/bin/phpunit --testdox
        vendor/bin/phpunit --filter <method_name>
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         resolveDependencies="true"
         requireCoverageMetadata="false"
         beStrictAboutCoverageMetadata="false"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <!-- Point these at the extension's PHP. A component usually
                 wants admin/src and site/src; a library wants src. -->
            <directory>src</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>node_modules</directory>
            <directory>build</directory>
        </exclude>
    </source>
</phpunit>
